        <div className="max-w-6xl mx-auto grid grid-cols-1 md:grid-cols-3 gap-6">
          {TESTIMONIALS.map((t) => (
            <div key={t.id} className="p-5 rounded-2xl bg-[#090909] border border-[#D6AD58]/20 space-y-3">
              <p className="text-xs text-[#B8B8B8] italic">"{t.comment}"</p>
              <h4 className="text-xs font-bold text-white">- {t.name}</h4>
            </div>
          ))}
        </div>
      </section>

      {/* CONTACT */}
      <section id="contact" className="py-16 px-4 max-w-6xl mx-auto">
        <div className="grid grid-cols-1 md:grid-cols-2 gap-8">
          <div className="space-y-4">
            <span className="text-xs font-bold text-[#D6AD58] uppercase">CONTACT US</span>
            <h2 className="text-3xl font-bold text-white">Get In Touch</h2>
            <p className="text-xs text-[#B8B8B8]">WhatsApp / Phone: +{config.whatsappNumber}</p>
            <p className="text-xs text-[#B8B8B8]">Opening Hours: 11:00 AM – 11:00 PM</p>
          </div>
          
          <form onSubmit={(e) => { e.preventDefault(); setContactSuccess(true); }} className="bg-[#151515] p-6 rounded-2xl border border-[#D6AD58]/30 space-y-3">
            {contactSuccess ? (
              <p className="text-green-400 text-xs">Message sent successfully!</p>
            ) : (
              <>
                <input type="text" placeholder="Your Name" required className="w-full p-2.5 rounded-xl bg-[#090909] border border-[#D6AD58]/30 text-xs text-white" />
                <textarea placeholder="Message" rows="3" required className="w-full p-2.5 rounded-xl bg-[#090909] border border-[#D6AD58]/30 text-xs text-white" />
                <button type="submit" className="w-full py-2.5 rounded-xl bg-gradient-to-r from-[#D6AD58] to-[#E8C77E] text-black font-bold text-xs">Send</button>
              </>
            )}
          </form>
        </div>
      </section>

      {/* FOOTER */}
      <footer className="bg-[#090909] border-t border-[#D6AD58]/20 py-8 px-4 text-center text-xs text-[#B8B8B8] space-y-2">
        <p>© {new Date().getFullYear()} {config.restaurantName}. All Rights Reserved.</p>
        <button onClick={() => { setTempConfig(config); setIsAdminOpen(true); }} className="text-[#D6AD58] underline text-[11px]">
          [ Owner Settings & Price Panel ]
        </button>
      </footer>

      {/* FLOATING WHATSAPP BUTTON */}
      <a 
        href={`https://wa.me/${config.whatsappNumber}?text=${encodeURIComponent('Hi! I would like to order food from ' + config.restaurantName)}`}
        target="_blank"
        rel="noreferrer"
        className="fixed bottom-6 right-6 z-40 p-4 rounded-full bg-green-500 text-white shadow-2xl hover:scale-110 transition-transform"
      >
        <MessageSquare className="w-6 h-6" />
      </a>

    </div>
  );
}
