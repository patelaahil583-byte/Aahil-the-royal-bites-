// --- MAIN APPLICATION COMPONENT ---
export default function App() {
  // Store Config (Owner changeable)
  const [config, setConfig] = useState(() => {
    try {
      const saved = localStorage.getItem('royal_bites_config');
      return saved ? JSON.parse(saved) : DEFAULT_CONFIG;
    } catch {
      return DEFAULT_CONFIG;
    }
  });

  // Food Menu Items (Owner editable prices)
  const [menuItems, setMenuItems] = useState(() => {
    try {
      const saved = localStorage.getItem('royal_bites_menu');
      return saved ? JSON.parse(saved) : INITIAL_MENU_ITEMS;
    } catch {
      return INITIAL_MENU_ITEMS;
    }
  });

  // Cart State
  const [cart, setCart] = useState(() => {
    try {
      const localCart = localStorage.getItem('royal_bites_cart');
      return localCart ? JSON.parse(localCart) : [];
    } catch {
      return [];
    }
  });

  // Modals & UI States
  const [isCartOpen, setIsCartOpen] = useState(false);
  const [isCheckoutOpen, setIsCheckoutOpen] = useState(false);
  const [isAdminOpen, setIsAdminOpen] = useState(false);
  const [selectedFood, setSelectedFood] = useState(null);
  const [mobileMenuOpen, setMobileMenuOpen] = useState(false);
  const [selectedCategory, setSelectedCategory] = useState('All Items');
  const [searchQuery, setSearchQuery] = useState('');
  const [lightboxImg, setLightboxImg] = useState(null);
  const [toastMessage, setToastMessage] = useState(null);

  // Form State
  const [checkoutData, setCheckoutData] = useState({
    name: '',
    phone: '',
    address: '',
    locality: '',
    landmark: '',
    instructions: ''
  });
  const [formErrors, setFormErrors] = useState({});
  const [contactData, setContactData] = useState({ name: '', email: '', message: '' });
  const [contactSuccess, setContactSuccess] = useState(false);

  // Temp Owner Admin Form State
  const [tempConfig, setTempConfig] = useState(config);
  const [editingItemPrice, setEditingItemPrice] = useState({});

  // Sync Config and Menu to LocalStorage
  useEffect(() => {
    try {
      localStorage.setItem('royal_bites_config', JSON.stringify(config));
    } catch (e) { console.error(e); }
  }, [config]);

  useEffect(() => {
    try {
      localStorage.setItem('royal_bites_menu', JSON.stringify(menuItems));
    } catch (e) { console.error(e); }
  }, [menuItems]);

  useEffect(() => {
    try {
      localStorage.setItem('royal_bites_cart', JSON.stringify(cart));
    } catch (e) { console.error(e); }
  }, [cart]);

  // Helper Toast
  const showToast = (msg) => {
    setToastMessage(msg);
    setTimeout(() => setToastMessage(null), 3000);
  };

  // Cart Calculations
  const cartItemCount = useMemo(() => cart.reduce((total, i) => total + i.quantity, 0), [cart]);
  const subtotal = useMemo(() => cart.reduce((total, i) => total + (i.price * i.quantity), 0), [cart]);
  const isFreeDelivery = subtotal >= config.freeDeliveryThreshold;
  const actualDeliveryFee = isFreeDelivery || subtotal === 0 ? 0 : Number(config.deliveryFee);
  const grandTotal = subtotal + actualDeliveryFee;

  // Cart Actions
  const addToCart = (item, quantity = 1, instructions = '') => {
    setCart(prev => {
      const idx = prev.findIndex(i => i.id === item.id && i.instructions === instructions);
      if (idx > -1) {
        const next = [...prev];
        next[idx].quantity += quantity;
        return next;
      }
      return [...prev, { ...item, quantity, instructions }];
    });
    showToast(`Added "${item.name}" to cart!`);
  };

  const updateQuantity = (id, instructions, delta) => {
    setCart(prev => prev.map(i => {
      if (i.id === id && i.instructions === instructions) {
        const newQ = i.quantity + delta;
        return newQ > 0 ? { ...i, quantity: newQ } : null;
      }
      return i;
    }).filter(Boolean));
  };

  const removeFromCart = (id, instructions) => {
    setCart(prev => prev.filter(i => !(i.id === id && i.instructions === instructions)));
    showToast("Item removed");
  };

  // Filter Menu
  const filteredMenu = useMemo(() => {
    return menuItems.filter(item => {
      const matchCat = selectedCategory === 'All Items' || item.category === selectedCategory;
      const matchSearch = item.name.toLowerCase().includes(searchQuery.toLowerCase()) || 
                          item.description.toLowerCase().includes(searchQuery.toLowerCase());
      return matchCat && matchSearch;
    });
  }, [selectedCategory, searchQuery, menuItems]);

  // Submit Order via WhatsApp
  const handleCheckoutSubmit = (e) => {
    e.preventDefault();
    const errors = {};
    if (!checkoutData.name.trim()) errors.name = "Name is required";
    if (!checkoutData.phone.trim() || !/^\d{10}$/.test(checkoutData.phone.replace(/\D/g, ''))) {
      errors.phone = "Enter valid 10-digit number";
    }
    if (!checkoutData.address.trim()) errors.address = "Address is required";
    if (!checkoutData.locality.trim()) errors.locality = "Locality is required";

    setFormErrors(errors);

    if (Object.keys(errors).length === 0) {
      let msg = `👑 *NEW ORDER - ${config.restaurantName}* 👑\n\n`;
      msg += `👤 *Customer Details:*\n`;
      msg += `• Name: ${checkoutData.name}\n`;
      msg += `• Phone: ${checkoutData.phone}\n`;
      msg += `• Address: ${checkoutData.address}, ${checkoutData.locality}\n`;
      if (checkoutData.landmark) msg += `• Landmark: ${checkoutData.landmark}\n`;
      msg += `\n🍽️ *Order Items:*\n`;

      cart.forEach((item, index) => {
        msg += `${index + 1}. *${item.name}* x ${item.quantity} = ₹${item.price * item.quantity}\n`;
        if (item.instructions) msg += `   └ Note: ${item.instructions}\n`;
      });

      msg += `\n-------------------------------\n`;
      msg += `💰 Subtotal: ₹${subtotal}\n`;
      msg += `🚚 Delivery Charge: ${actualDeliveryFee === 0 ? 'FREE' : '₹' + actualDeliveryFee}\n`;
      msg += `🌟 *Total Payable: ₹${grandTotal}*\n`;
      msg += `-------------------------------\n`;
      if (checkoutData.instructions) {
        msg += `📝 *Note:* ${checkoutData.instructions}\n\n`;
      }
      msg += `Please confirm my order and send estimated delivery time. Thanks!`;

      const waUrl = `https://wa.me/${config.whatsappNumber}?text=${encodeURIComponent(msg)}`;
      window.open(waUrl, '_blank');
      showToast("Redirecting to WhatsApp to send order...");
      setIsCheckoutOpen(false);
      setIsCartOpen(false);
    }
  };

  // Save Owner Settings
  const handleSaveAdminSettings = () => {
    setConfig(tempConfig);
    // Apply menu price changes
    setMenuItems(prev => prev.map(item => ({
      ...item,
      price: editingItemPrice[item.id] !== undefined ? Number(editingItemPrice[item.id]) : item.price
    })));
    setIsAdminOpen(false);
    showToast("Owner Settings Saved Successfully!");
  };

  // Reset to Default
  const handleResetDefaults = () => {
    setConfig(DEFAULT_CONFIG);
    setMenuItems(INITIAL_MENU_ITEMS);
    setTempConfig(DEFAULT_CONFIG);
    setEditingItemPrice({});
    showToast("Reset to initial defaults");
  };

  return (
    <div className="min-h-screen bg-[#090909] text-white font-sans selection:bg-[#D6AD58] selection:text-black">
      
      {/* TOAST NOTIFICATION */}
      {toastMessage && (
        <div className="fixed top-20 right-4 z-50 bg-[#151515] border border-[#D6AD58]/50 text-[#E8C77E] px-5 py-3 rounded-xl shadow-2xl flex items-center gap-3 animate-bounce">
          <Sparkles className="w-5 h-5 text-[#D6AD58]" />
          <span className="font-medium text-sm text-white">{toastMessage}</span>
        </div>
      )}

      {/* STICKY NAVIGATION BAR */}
      <nav className="sticky top-0 z-40 backdrop-blur-md bg-[#090909]/90 border-b border-[#D6AD58]/20 transition-all">
        <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
          
          {/* Logo */}
          <a href="#" className="flex items-center gap-2 group">
            <div className="w-10 h-10 rounded-full border border-[#D6AD58] flex items-center justify-center bg-[#151515] group-hover:border-[#E8C77E]">
              <Utensils className="w-5 h-5 text-[#D6AD58]" />
            </div>
            <div>
              <span className="text-xl font-bold tracking-widest text-transparent bg-clip-text bg-gradient-to-r from-[#D6AD58] via-[#E8C77E] to-[#D6AD58]">
                {config.restaurantName}
              </span>
              <span className="block text-[9px] tracking-widest text-[#B8B8B8] uppercase">Premium Taste & Fast Delivery</span>
            </div>
          </a>

          {/* Desktop Nav Links */}
          <div className="hidden md:flex items-center gap-7 text-sm font-medium">
            {['Home', 'Offers', 'Menu', 'About', 'Gallery', 'Testimonials', 'Contact'].map((link) => (
              <a key={link} href={`#${link.toLowerCase()}`} className="text-[#B8B8B8] hover:text-[#D6AD58] transition-colors py-1">
                {link}
              </a>
            ))}
          </div>

          {/* Action Buttons */}
          <div className="flex items-center gap-3">
            {/* Owner Settings Toggle Button */}
            <button 
              onClick={() => {
                setTempConfig(config);
                setIsAdminOpen(true);
              }}
              className="p-2.5 rounded-full bg-[#151515] border border-[#D6AD58]/30 hover:border-[#D6AD58] text-[#D6AD58] transition-all"
              title="Owner / Admin Controls"
            >
              <Settings className="w-5 h-5" />
            </button>

            {/* Cart Button */}
            <button 
              onClick={() => setIsCartOpen(true)}
              className="relative p-2.5 rounded-full bg-[#151515] border border-[#D6AD58]/30 hover:border-[#D6AD58] text-[#E8C77E] transition-all"
              aria-label="Shopping Cart"
            >
              <ShoppingBag className="w-5 h-5" />
              {cartItemCount > 0 && (
                <span className="absolute -top-1 -right-1 bg-gradient-to-r from-[#D6AD58] to-[#E8C77E] text-black font-bold text-xs w-5 h-5 rounded-full flex items-center justify-center">
                  {cartItemCount}
                </span>
              )}
            </button>

            {/* CTA Button */}
            <a 
              href="#menu" 
              className="hidden sm:inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-gradient-to-r from-[#D6AD58] to-[#E8C77E] text-black font-semibold text-sm hover:brightness-110 transition-all shadow-md"
            >
              Order Now
              <ChevronRight className="w-4 h-4" />
            </a>

            {/* Mobile Hamburger */}
            <button 
              onClick={() => setMobileMenuOpen(!mobileMenuOpen)}
              className="md:hidden p-2 rounded-lg bg-[#151515] text-[#D6AD58] border border-[#D6AD58]/20"
            >
              {mobileMenuOpen ? <X className="w-6 h-6" /> : <MenuIcon className="w-6 h-6" />}
            </button>
          </div>
        </div>

        {/* Mobile Menu */}
        {mobileMenuOpen && (
          <div className="md:hidden bg-[#090909] border-b border-[#D6AD58]/30 px-6 py-6 space-y-4">
            {['Home', 'Offers', 'Menu', 'About', 'Gallery', 'Testimonials', 'Contact'].map((link) => (
              <a 
                key={link} 
                href={`#${link.toLowerCase()}`}
                onClick={() => setMobileMenuOpen(false)}
                className="block text-lg font-medium text-[#B8B8B8] hover:text-[#D6AD58]"
              >
                {link}
              </a>
            ))}
            <button 
              onClick={() => {
                setMobileMenuOpen(false);
                setIsAdminOpen(true);
              }}
              className="block w-full text-left py-2 text-[#D6AD58] font-bold text-sm flex items-center gap-2"
            >
              <Settings className="w-4 h-4" /> Owner Settings Panel
            </button>
          </div>
        )}
      </nav>

      {/* HERO SECTION */}
      <section id="home" className="relative min-h-[80vh] flex items-center justify-center py-20 px-4 overflow-hidden">
        <div className="absolute inset-0 z-0">
          <img 
            src="https://images.unsplash.com/photo-1544025162-d76694265947?auto=format&fit=crop&q=80&w=1920" 
            alt="Royal Gourmet Background" 
            className="w-full h-full object-cover opacity-20"
          />
          <div className="absolute inset-0 bg-gradient-to-t from-[#090909] via-[#090909]/70 to-[#090909]/90" />
        </div>

        <div className="relative z-10 max-w-4xl mx-auto text-center space-y-8">
          <div className="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-[#151515] border border-[#D6AD58]/40 text-[#E8C77E] text-xs font-semibold tracking-wider uppercase">
            <Sparkles className="w-4 h-4 text-[#D6AD58]" /> Fast Home Delivery & Royal Flavors
          </div>

          <h1 className="text-4xl sm:text-6xl font-extrabold tracking-tight text-white leading-tight">
            Where Every Bite Feels <br className="hidden sm:inline" />
            <span className="text-transparent bg-clip-text bg-gradient-to-r from-[#D6AD58] via-[#FCE8B3] to-[#E8C77E]">
              Truly Royal
            </span>
          </h1>

